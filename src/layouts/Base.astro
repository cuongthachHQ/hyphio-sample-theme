---
// A theme layout must render EmDash's page fragments (EmDashHead, EmDashBodyStart, EmDashBodyEnd): Hyphio's
// analytics, verification tags and cookie consent come through them.
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { currentLang, intlLocale } from "../i18n";
import "../styles/theme.css";

interface Props {
	title: string;
}
const { title } = Astro.props;
const lang = currentLang(Astro);
const pageCtx = createPublicPageContext({ Astro, kind: "custom", title, pageTitle: title });
---

<!doctype html>
<html lang={intlLocale(lang)}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<main class="page"><slot /></main>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
